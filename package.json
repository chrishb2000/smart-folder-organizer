{
  "name": "smart-folder-organizer",
  "version": "3.0.1",
  "description": "Organizador inteligente de carpetas: clasifica archivos, detecta duplicados, imagenes similares, extensiones incorrectas, archivos rotos, renombra en lote y exporta informes. 100% local y privado.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/scanner.test.js && node test/planner.test.js && node test/imghash.test.js && node test/renamer.test.js && node test/signatures.test.js && node test/stats.test.js && node test/reporter.test.js",
    "test:e2e": "electron test/e2e.smoke.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "keywords": [
    "file-organizer",
    "duplicate-finder",
    "disk-cleaner",
    "folder-manager",
    "electron",
    "file-management",
    "desktop-app"
  ],
  "author": "Christian Herencia",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.christianfreelance.smartfolderorganizer",
    "productName": "Smart Folder Organizer",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "lib/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "SmartFolderOrganizer_${version}_portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "SmartFolderOrganizer_Setup_${version}.exe"
    }
  },
  "dependencies": {
    "exif-parser": "^0.1.12",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  }
}
